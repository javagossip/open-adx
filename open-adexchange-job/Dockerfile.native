# ============================================
# Stage 1: 使用 GraalVM 构建原生可执行文件
# ============================================
FROM ghcr.io/graalvm/graalvm-community:21 AS builder

# 构建环境：dev / test / prod / docker，控制 log4j2.xml 等 profile 资源
ARG ENV_ID=docker

WORKDIR /build
COPY . .

RUN chmod +x mvnw \
    && ./mvnw -Pnative -Denv.id=${ENV_ID} -Djib.skip=true -pl open-adexchange-job -am package -DskipTests

# ============================================
# Stage 2: 最小化运行时镜像
# ============================================
FROM debian:bookworm-slim

RUN groupadd -r app && useradd -r -g app app \
    && apt-get update && apt-get install -y --no-install-recommends \
       libz1 curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/open-adexchange-job/target/oax-job .
RUN chmod +x oax-job

USER app
EXPOSE 8082

ENTRYPOINT ["./oax-job"]
